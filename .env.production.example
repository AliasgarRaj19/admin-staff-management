NODE_ENV=production
PORT=5500
CLIENT_URL=https://example.com/admin-staff
APP_URL=https://example.com
APP_BASE_PATH=/admin-staff
DATABASE_URL=
JWT_ISSUER=admin-staff-management
JWT_AUDIENCE=admin-staff-management-staff
JWT_ACCESS_PRIVATE_KEY_PATH=/run/secrets/jwt/access-current-private.pem
JWT_ACCESS_PUBLIC_KEY_PATH=/run/secrets/jwt/access-current-public.pem
JWT_ACCESS_PREVIOUS_PUBLIC_KEY_PATH=
JWT_ACCESS_KID=
JWT_ACCESS_PREVIOUS_KID=
JWT_REFRESH_PRIVATE_KEY_PATH=/run/secrets/jwt/refresh-current-private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=/run/secrets/jwt/refresh-current-public.pem
JWT_REFRESH_PREVIOUS_PUBLIC_KEY_PATH=
JWT_REFRESH_KID=
JWT_REFRESH_PREVIOUS_KID=
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
RATE_LIMIT_DEV_MULTIPLIER=20
RATE_LIMIT_DEV_WINDOW_MS=60000
POSTGRES_DB=admin_staff_management
POSTGRES_USER=admin_staff_user
POSTGRES_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=
MASTER_ADMIN_EMAIL=
